<mxfile host="app.diagrams.net" version="24.0.0"><diagram id="DR-M-05" name="课程教学班与作品归属（关系示意）"><mxGraphModel pageWidth="1100" pageHeight="900" page="1"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="edge0" value="1名教师 → 0..*个教学班&#10;本次候选每班1名主审" style="endArrow=none;html=0;" edge="1" parent="1" source="teacher" target="classroom"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge1" value="1个教学班 → 0..*个组&#10;每组属于1个教学班" style="endArrow=none;html=0;" edge="1" parent="1" source="classroom" target="group"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge2" value="每组1..*名班内学生&#10;每人本班最多1组（候选）" style="endArrow=none;html=0;" edge="1" parent="1" source="group" target="student"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge3" value="每组0..1份本次任务作品&#10;未提交组也在班级总览" style="endArrow=none;html=0;" edge="1" parent="1" source="group" target="work"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge4" value="1份作品 → 1..*版本&#10;新版不覆盖旧版" style="endArrow=none;html=0;" edge="1" parent="1" source="work" target="version"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge5" value="1个版本 → 0..*次审查&#10;决定不跨组/跨作品混写" style="endArrow=none;html=0;" edge="1" parent="1" source="version" target="run"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="teacher" value="教师&#10;教师编号" style="rounded=0;whiteSpace=wrap;html=0;fontSize=15;fillColor=#edf4fb;strokeColor=#356d96;" vertex="1" parent="1"><mxGeometry as="geometry" x="55.0" y="105.0" width="210" height="90" /></mxCell><mxCell id="classroom" value="课程教学班&#10;班编号、课程、学期&#10;负责教师编号" style="rounded=0;whiteSpace=wrap;html=0;fontSize=15;fillColor=#edf4fb;strokeColor=#356d96;" vertex="1" parent="1"><mxGeometry as="geometry" x="430.0" y="100.0" width="240" height="100" /></mxCell><mxCell id="group" value="课程小组&#10;组编号、教学班编号" style="rounded=0;whiteSpace=wrap;html=0;fontSize=15;fillColor=#edf4fb;strokeColor=#356d96;" vertex="1" parent="1"><mxGeometry as="geometry" x="430.0" y="360.0" width="240" height="90" /></mxCell><mxCell id="student" value="班内学生&#10;学生编号、组归属" style="rounded=0;whiteSpace=wrap;html=0;fontSize=15;fillColor=#edf4fb;strokeColor=#356d96;" vertex="1" parent="1"><mxGeometry as="geometry" x="55.0" y="360.0" width="210" height="90" /></mxCell><mxCell id="work" value="小组作品&#10;作品编号、教学班、组" style="rounded=0;whiteSpace=wrap;html=0;fontSize=15;fillColor=#edf4fb;strokeColor=#356d96;" vertex="1" parent="1"><mxGeometry as="geometry" x="820.0" y="360.0" width="240" height="90" /></mxCell><mxCell id="version" value="文档版本&#10;作品编号、版本编号&#10;原文与提交记录" style="rounded=0;whiteSpace=wrap;html=0;fontSize=15;fillColor=#edf4fb;strokeColor=#356d96;" vertex="1" parent="1"><mxGeometry as="geometry" x="820.0" y="640.0" width="240" height="100" /></mxCell><mxCell id="run" value="审查任务及复核&#10;关联作品版本&#10;问题与教师决定" style="rounded=0;whiteSpace=wrap;html=0;fontSize=15;fillColor=#edf4fb;strokeColor=#356d96;" vertex="1" parent="1"><mxGeometry as="geometry" x="430.0" y="640.0" width="240" height="100" /></mxCell></root></mxGraphModel></diagram></mxfile>